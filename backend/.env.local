# QA Reporter Backend - Local Development
NODE_ENV=development
PORT=3000
HOST=localhost

# Claude API (optional for demo mode)
# Leave empty to use demo mode without API key
# Add your key here to enable real AI analysis
CLAUDE_API_KEY=

# Server URL (for extension to connect back)
SERVER_URL=http://localhost:3000

# Uploads directory
UPLOADS_DIR=./uploads

# Demo mode
DEMO_MODE=true
