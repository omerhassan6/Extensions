{
	"compilerOptions": {
		"module": "commonjs",
		"target": "ES2020",
		"outDir": "out",
		"lib": [
		"ES2020",
		"DOM",
		"DOM.Iterable",
		"WebWorker"
	],
		"sourceMap": true,
		"rootDir": ".",
		"strict": true,
		"skipLibCheck": true
	},
	"include": [
		"src",
		"extension/src"
	],
	"exclude": [
		"node_modules",
		".vscode-test"
	]
}
